# Neon pooled connection string (server-only)
DATABASE_URL=
# Optional direct connection for Drizzle Kit migrations
DATABASE_URL_UNPOOLED=

# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Exact Google-verified email permitted to create the first account, once only
BOOTSTRAP_OWNER_EMAIL=

# Google OAuth credentials. Callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set automatically when the Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=
