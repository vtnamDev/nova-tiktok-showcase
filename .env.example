# Neon pooled connection string. Server-only; never use VITE_ prefix.
DATABASE_URL=

# Generate a random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap identity: only this email can create the first account before an Owner exists.
BOOTSTRAP_OWNER_EMAIL=

# Google OAuth credentials. Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob (create a Blob store in the Vercel project)
BLOB_READ_WRITE_TOKEN=
